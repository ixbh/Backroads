# Server-side only. Requires PostgreSQL with PostGIS and schema.sql applied.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/routes
# Desktop alternative: a generated read-only SQLite routing snapshot. When
# set, this takes precedence over DATABASE_URL. The desktop launcher sets it
# automatically; normal PostgreSQL development should leave it unset.
# BACKROADS_SQLITE_PATH=C:\path\to\backroads.sqlite3
# Optional comma-separated browser origins when frontend and API are hosted
# separately. Leave unset when FastAPI serves viewer.html from the same host.
ALLOWED_ORIGINS=https://backroad.example.com
# Server-side geocoder adapter. The default is the public OSM Nominatim
# service and is appropriate only for modest, user-triggered beta searches.
# Change the URL to another Nominatim-compatible provider without rebuilding
# the desktop app. Never put a paid provider key in viewer.html.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=Backroad-Beta/0.2 (+https://github.com/ixbh/Backroads)
GEOCODER_COUNTRY_CODES=us
